# Copy to .env (git-ignored) to override defaults. Everything is optional for local development.
# `npm start`, `npm run dev` and `npm run seed` load .env automatically.

# PORT=3000
# HOST=0.0.0.0

# Database: a local SQLite file by default. Set both to use a Turso database instead.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=

# Photos: local ./uploads by default. Set to store them in Vercel Blob instead.
# BLOB_READ_WRITE_TOKEN=
# UPLOADS_DIR=./uploads

# Seed demo accounts and listings when the database is empty (default true).
# SEED_DEMO_DATA=false

# Browser origins allowed to call the API, comma-separated, or * (default).
# CORS_ORIGINS=http://localhost:5173,https://purecs-market-web.vercel.app
